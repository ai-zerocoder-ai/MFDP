FROM python:3.11-slim

# ─────────────────────────────────────────────────────────────────────────────
# 1) Устанавливаем системные пакеты, необходимые для сборки зависимостей
# ─────────────────────────────────────────────────────────────────────────────
RUN apt-get update && \
    apt-get install -y --no-install-recommends \
      build-essential \
      libgl1-mesa-glx \
      curl \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# ─────────────────────────────────────────────────────────────────────────────
# 2) Копируем только «requirements.txt» для backend и bot, чтобы закешировать
#    слой установки пакетов, прежде чем добавлять весь код
# ─────────────────────────────────────────────────────────────────────────────
COPY backend/requirements.txt  /app/backend/requirements.txt
COPY bot/requirements.txt      /app/bot/requirements.txt

# ─────────────────────────────────────────────────────────────────────────────
# 3) Устанавливаем все зависимости одной командой:
#    • зависимости backend (Django, DRF, Celery, httpx, Pillow и т.д.)
#    • pytest и pytest-django для тестирования backend
#    • зависимости bot (aiogram, httpx и т.д.)
#    • pytest-asyncio для тестирования bot
# ─────────────────────────────────────────────────────────────────────────────
RUN pip install --no-cache-dir \
      -r /app/backend/requirements.txt \
      pytest pytest-django httpx && \
    pip install --no-cache-dir \
      -r /app/bot/requirements.txt \
      pytest-asyncio

# ─────────────────────────────────────────────────────────────────────────────
# 4) Копируем весь исходный код после установки зависимостей
#    (изменения в коде не будут инвалидировать кеш слоя с pip install)
# ─────────────────────────────────────────────────────────────────────────────
COPY backend/ /app/backend/
COPY bot/     /app/bot/

# ─────────────────────────────────────────────────────────────────────────────
# 5) Копируем конфигурационные файлы pytest
# ─────────────────────────────────────────────────────────────────────────────
COPY pytest.ini   /app/pytest.ini
COPY conftest.py  /app/conftest.py

# ─────────────────────────────────────────────────────────────────────────────
# 6) Настраиваем переменные окружения для тестов Django
# ─────────────────────────────────────────────────────────────────────────────
ENV DJANGO_SETTINGS_MODULE=tattoo_intelligence.test_settings
ENV PYTHONPATH="/app/backend:/app/bot"
ENV PYTHONUNBUFFERED=1

WORKDIR /app

# ─────────────────────────────────────────────────────────────────────────────
# 7) По умолчанию запускаем pytest
# ─────────────────────────────────────────────────────────────────────────────
CMD ["pytest", "-q", "--disable-warnings", "--maxfail=1"]
