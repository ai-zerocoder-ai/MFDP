FROM python:3.11-slim

WORKDIR /app

# ─────────────────────────────────────────────────────────────────────────────
# 1) Устанавливаем системные пакеты + настраиваем кеш pip (требует BuildKit).
# ─────────────────────────────────────────────────────────────────────────────
RUN --mount=type=cache,target=/root/.cache/pip \
    apt-get update && \
    apt-get install -y --no-install-recommends \
      build-essential \
      libgl1-mesa-glx \
      curl \
    && rm -rf /var/lib/apt/lists/*

# ─────────────────────────────────────────────────────────────────────────────
# 2) Копируем файлы с зависимостями (чтобы закешировать слои до правок кода)
# ─────────────────────────────────────────────────────────────────────────────
COPY backend/requirements.txt /app/backend/requirements.txt
COPY bot/requirements.txt     /app/bot/requirements.txt

# ─────────────────────────────────────────────────────────────────────────────
# 3) Устанавливаем все Python-библиотеки единым слоем + кешируем pip
# ─────────────────────────────────────────────────────────────────────────────
RUN --mount=type=cache,target=/root/.cache/pip \
    pip install --no-cache-dir \
      -r /app/backend/requirements.txt \
      celery \
      -r /app/bot/requirements.txt

# ─────────────────────────────────────────────────────────────────────────────
# 4) Копируем теперь весь исходный код (backend + бот)
#    Менять код бота или бэкенда не побьёт кеш с уже установленными пакетами.
# ─────────────────────────────────────────────────────────────────────────────
COPY backend/ /app/backend/
COPY bot/     /app/bot/

# ─────────────────────────────────────────────────────────────────────────────
# 5) Настраиваем PYTHONPATH, чтобы Python видел "backend" как корень приложения
# ─────────────────────────────────────────────────────────────────────────────
ENV PYTHONPATH="/app/backend" \
    PYTHONUNBUFFERED=1

# ─────────────────────────────────────────────────────────────────────────────
# 6) Задаём рабочую директорию (где лежит main.py для бота) и точку входа
# ─────────────────────────────────────────────────────────────────────────────
WORKDIR /app/bot
CMD ["python", "main.py"]
