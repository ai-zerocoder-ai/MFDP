FROM python:3.11-slim

# ─────────────────────────────────────────────────────────────────────────────
# 1) Устанавливаем системные библиотеки, нужные для сборки
#    Например: Pillow, fal_client, httpx и т.д. часто требуют libGL, libglib и т.п.
# ─────────────────────────────────────────────────────────────────────────────
RUN apt-get update && \
    apt-get install -y --no-install-recommends \
        build-essential \
        libgl1-mesa-glx \
        libglib2.0-0 \
    && rm -rf /var/lib/apt/lists/*

# ─────────────────────────────────────────────────────────────────────────────
# 2) Создаём рабочую директорию и копируем туда только файл с зависимостями
# ─────────────────────────────────────────────────────────────────────────────
WORKDIR /app/backend

# Сначала копируем только requirements.txt, чтобы закешировать слой установки
COPY backend/requirements.txt /app/backend/requirements.txt

# ─────────────────────────────────────────────────────────────────────────────
# 3) Сразу устанавливаем ВСЕ библиотеки из requirements.txt
#    (все зависимости Django, DRF, Celery, httpx, Pillow и т.д.)
# ─────────────────────────────────────────────────────────────────────────────
RUN pip install --no-cache-dir -r /app/backend/requirements.txt

# ─────────────────────────────────────────────────────────────────────────────
# 4) Теперь копируем весь код бэкенда (т.к. зависимости уже установлены,
#    изменений в исходниках не обнулят кеш pip-слоя)
# ─────────────────────────────────────────────────────────────────────────────
COPY backend/ /app/backend/

# ─────────────────────────────────────────────────────────────────────────────
# 5) Настраиваем PYTHONPATH, чтобы Celery мог найти модуль tattoo_intelligence
# ─────────────────────────────────────────────────────────────────────────────
ENV PYTHONPATH="/app/backend"
ENV PYTHONUNBUFFERED=1

# ─────────────────────────────────────────────────────────────────────────────
# 6) Запускаем Celery-worker:
#    -A celery_app  → celery_app.py (в /app/backend)
# ─────────────────────────────────────────────────────────────────────────────
CMD ["celery", "-A", "celery_app", "worker", "--loglevel=info"]
